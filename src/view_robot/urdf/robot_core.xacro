<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <material name="black">  <color rgba="0 0 0 1"/>       </material>
  <material name="white">  <color rgba="1 1 1 1"/>       </material>
  <material name="blue">   <color rgba="0.2 0.2 1 1"/>   </material>
  <material name="silver"> <color rgba="0.8 0.8 0.8 1"/> </material>

  <link name="odom"/>
  <link name="base_link"/>

  <joint name="base_link_joint" type="fixed">
    <parent link="odom"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== Нижняя платформа ===== -->
  <!-- base_link теперь в центре колёс, корпус смещён назад на -0.05 -->
  <joint name="base_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_plate"/>
    <origin xyz="-0.05 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_plate">
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.23 0.005"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.23 0.005"/></geometry>
    </collision>
    <xacro:inertial_box mass="1.5" x="0.2" y="0.23" z="0.005">
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="base_plate">
    <material>
      Gazebo/White
    </material>
  </gazebo>

  <!-- ===== Четыре стойки ===== -->
  <xacro:macro name="rod" params="name x y">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_plate"/>
      <child link="${name}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${name}">
      <visual>
        <origin xyz="${x} ${y} 0.1" rpy="0 0 0"/>
        <geometry><cylinder length="0.19" radius="0.005"/></geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="${x} ${y} 0.1" rpy="0 0 0"/>
        <geometry><cylinder length="0.19" radius="0.005"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.05" length="0.19" radius="0.005">
        <origin xyz="${x} ${y} 0.1" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <gazebo reference="rod">
    <material>
      Gazebo/Black
    </material>
  </gazebo>

  <xacro:rod name="rod_front_left"  x=" 0.09" y=" 0.105"/>
  <xacro:rod name="rod_front_right" x=" 0.09" y="-0.105"/>
  <xacro:rod name="rod_rear_left"   x="-0.09" y=" 0.105"/>
  <xacro:rod name="rod_rear_right"  x="-0.09" y="-0.105"/>

  <!-- ===== Колёса: x=0, base_link теперь их центр ===== -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.095 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="200.0" velocity="20.0"/>
  </joint>
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder length="0.025" radius="0.0325"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder length="0.025" radius="0.0325"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="1.0" length="0.025" radius="0.0325">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="left_wheel">
    <material>
      Gazebo/Blue
    </material>
  </gazebo>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.095 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="200.0" velocity="20.0"/>
  </joint>
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder length="0.025" radius="0.0325"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder length="0.025" radius="0.0325"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="1.0" length="0.025" radius="0.0325">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="right_wheel">
    <material>
      Gazebo/Blue
    </material>
  </gazebo>

  <!-- ===== Кастер: было x=-0.09, теперь x=-0.14 ===== -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.14 0 -0.01" rpy="0 0 0"/>
  </joint>
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <xacro:inertial_sphere mass="0.1" radius="0.015">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <gazebo reference="caster_wheel">
    <material>
      Gazebo/Blue
    </material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- ===== Средняя плата электроники ===== -->
  <joint name="electronics_plate_joint" type="fixed">
    <parent link="base_plate"/>
    <child link="electronics_plate"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>
  <link name="electronics_plate">
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.23 0.005"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.23 0.005"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.3" x="0.2" y="0.23" z="0.005">
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="electronic_plate">
    <material>
      Gazebo/White
    </material>
  </gazebo>

  <!-- ===== Верхняя платформа ===== -->
  <joint name="top_plate_joint" type="fixed">
    <parent link="electronics_plate"/>
    <child link="top_plate"/>
    <origin xyz="0 0 0.130" rpy="0 0 0"/>
  </joint>
  <link name="top_plate">
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.23 0.005"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.23 0.005"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.8" x="0.2" y="0.23" z="0.005">
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="top_plate">
    <material>
      Gazebo/White
    </material>
  </gazebo>

  <!-- ===== ros2_control ===== -->
  <ros2_control name="my_robot_hardware" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="update_rate" type="int">50</param>
      <param name="calculate_dynamics" type="bool">true</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>